#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
  double alfa, startSpeed, radianAlfa, doubleRadianAlfa, timeFly,
         maxHeight, maxRange, startCurvatureRadius, apexCurvatureRadius;
  const double gravity = 9.81;          // Коэфицент свободного падения
  const double pi = 3.14;               // Число Пи

  cout << "Alfa = ";
  cin >> alfa;

  cout << "Start speed = ";
  cin >> startSpeed;

  radianAlfa = alfa * pi / 180.0;       // Из угла получем радианы для использования cos()
  doubleRadianAlfa = 2.0 * radianAlfa;  // Двойной угол = двойные радианы 

  timeFly = (2.0 * startSpeed * sin(radianAlfa)) / gravity;
  maxHeight = pow(startSpeed, 2.0) * pow(sin(radianAlfa), 2.0) / (2.0 * gravity);
  maxRange = pow(startSpeed, 2.0) * sin(doubleRadianAlfa) / gravity;
  startCurvatureRadius = pow(startSpeed, 2.0) / (gravity * cos(radianAlfa));
  apexCurvatureRadius = pow(startSpeed, 2.0) * pow(cos(radianAlfa), 2.0) / gravity;

  cout << fixed << setprecision(6)       // 6 чисел после запятой
       << "Time of flying = " << timeFly << endl
       << "Max height = " << maxHeight << endl
       << "Max range = " << maxRange << endl
       << "Radius of start curvature = " << startCurvatureRadius << endl
       << "Radius of apex curvature = " << apexCurvatureRadius << endl;

  return 0;
}
